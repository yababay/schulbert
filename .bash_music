DOWNLOAD_DIR="$HOME/Загрузки"

update_tags () {
    # Сортированный список m3u файлов текущей папки
    ls -1 *.m3u 2>/dev/null | while read -r l; do
        # Корректно меняем расширение .m3u на .sh
        sh_file="$(echo "$l" | sed -E 's/\.m3u$/.sh/')"
        sh_path="$DOWNLOAD_DIR/$sh_file" 
        
        if [ ! -f "$sh_path" ]; then
		# echo "❌ Файл $sh_path отсутствует."
		continue
        fi
        echo "🏭 Обрабатывается файл $sh_path…"
	    
        # Переносим скрипт из Загрузок в текущую папку альбома
        mv "$sh_path" ./
	    
        # Запускаем прошивку русских тегов в mp3-файлы
        # Флаг -e внутри bash заставит его прерваться, если агент выдаст ошибку
        echo "🎵 Запуск скрипта прошивки $sh_file..."
        sh "./$sh_file"
	    
        # Переносим отработавший скрипт в архивную скрытую папку .done, 
        # чтобы он не мозолил глаза и не запускался повторно
        mkdir -p .done
        mv "$sh_file" .done/
	    
        echo "✅ Прошивка тегов для плейлиста $l успешно завершена!"
        continue
        
    done
}

