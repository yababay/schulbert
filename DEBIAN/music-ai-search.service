[Unit]
Description=Локальный ИИ-сервер поиска музыки (FastAPI + pgvector)
After=network.target

[Service]
Type=simple
# Задаем рабочую директорию — теперь все относительные пути считаются от неё!
WorkingDirectory=/usr/share/schulbert

# 🌟 ЭЛЕГАНТНОЕ РЕШЕНИЕ: Подменяем PATH для этого юнита.
# systemd сам найдет нужный интерпретатор в .venv/bin, как если бы мы сделали source!
Environment="PATH=/usr/share/schulbert/.venv/bin:/usr/local/bin:/usr/bin:/bin"

# Теперь пишем короткие, красивые пути относительно WorkingDirectory
ExecStart=python3 music-ai-search.py

Restart=on-failure
RestartSec=5s

[Install]
WantedBy=default.target
